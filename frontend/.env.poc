# POC mode: `npm run serve-poc`. Values not set here come from your local .env.development
# (loaded in vue.config.js). No secrets in this file.
NODE_ENV=development
VUE_APP_POC_MOCK=true
VUE_APP_MFA_STATUS=false
VUE_APP_DATADOG_STATUS=false
# conversion backend: backend/app.py
POC_API_TARGET=http://localhost:5003
