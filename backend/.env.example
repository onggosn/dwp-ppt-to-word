# Salin ke .env lalu isi. .env tidak ikut git.
# Bedrock API key (AWS console > Amazon Bedrock > API keys), untuk region di bawah
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-3

# Opsional: path absolut ke PEM CA bundle tepercaya (mis. CA perusahaan).
# Dipakai oleh klien Claude dan Converse; kosong = sertifikat default SDK.
AWS_CA_BUNDLE=

# Inference profile Claude. Dari ap-southeast-3 (Jakarta) semua model Claude hanya lewat global.
# (diproses di region AWS mana saja); tidak ada in-region atau geo untuk Jakarta.
# Pilihan yang aktif di akun ini (dites 2026-11-02; Claude 4.7 ke atas -> 403):
#   global.anthropic.claude-opus-4-5-20251101-v1:0      dipakai sekarang; EOL paling cepat 24 Nov 2026
#   global.anthropic.claude-sonnet-4-6                  cadangan: baca tabel paling akurat, ringkas, tapi lambat (thinking)
#   global.anthropic.claude-opus-4-6-v1                 penulis terkuat, ~2x lebih lambat
#   moonshotai.kimi-k2.5                                bukan Claude, diproses DI Jakarta (lewat Converse API);
#                                                        baca grafik paling akurat, tapi tulisannya terlalu rinci
# API key harus dibuat di region yang sama dengan AWS_REGION.
BEDROCK_MODEL=global.anthropic.claude-opus-4-5-20251101-v1:0

# Jumlah panggilan AI paralel saat konversi (default 4). Lebih tinggi = lebih cepat, sampai batas kuota Bedrock.
BOOK_WORKERS=4
