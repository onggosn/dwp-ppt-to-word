{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flask-app",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "app.py"
      ],
      "port": 5001
    },
    {
      "name": "flask-app-mac",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-c",
        "import app; app.app.run(threaded=True, port=5002)"
      ],
      "port": 5002
    },
    {
      "name": "poc-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "poc_api.py"
      ],
      "port": 5003
    },
    {
      "name": "new-dwp-poc",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../new-dwp",
        "run",
        "serve-poc",
        "--",
        "--port",
        "8090"
      ],
      "port": 8090
    }
  ]
}
