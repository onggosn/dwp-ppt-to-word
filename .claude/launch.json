{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/app.py"
      ],
      "port": 5003
    },
    {
      "name": "backend-mac",
      "runtimeExecutable": ".venv-mac/bin/python",
      "runtimeArgs": [
        "backend/app.py"
      ],
      "port": 5003
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "serve-poc",
        "--",
        "--port",
        "8090"
      ],
      "port": 8090
    }
  ]
}
